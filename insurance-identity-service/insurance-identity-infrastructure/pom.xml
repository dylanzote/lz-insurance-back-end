<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.lz_insurance</groupId>
        <artifactId>insurance-identity-service</artifactId>
        <version>1.0-SNAPSHOT</version>
    </parent>

    <artifactId>insurance-identity-infrastructure</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <name>insurance-identity-infrastructure</name>
    <description>insurance-identity-infrastructure</description>
    <url/>
    <licenses>
        <license/>
    </licenses>
    <developers>
        <developer/>
    </developers>
    <scm>
        <connection/>
        <developerConnection/>
        <tag/>
        <url/>
    </scm>
    <properties>
        <java.version>25</java.version>
    </properties>
    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <!-- Actuator: exposes /actuator/health for the M1 boot/exit-gate verification -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- Boot 4 split the @DataJpaTest slice (incl. TestEntityManager, @AutoConfigureTestDatabase)
             out of starter-test into its own module — required for repository slice tests (US-M1-008). -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.lz_insurance.insurance.identity.api</groupId>
            <artifactId>insurance-identity-api</artifactId>
            <version>1.0-SNAPSHOT</version>
        </dependency>

        <!-- Domain model: target of Entity <-> Domain mappers -->
        <dependency>
            <groupId>com.lz_insurance.insurance.identity.domain</groupId>
            <artifactId>insurance-identity-domain</artifactId>
            <version>1.0-SNAPSHOT</version>
        </dependency>

        <!-- BaseJpaEntity, BaseRepository, BaseSpecification, JPA + Liquibase + Postgres -->
        <dependency>
            <groupId>com.lz_insurance.persistence</groupId>
            <artifactId>insurance-persistence</artifactId>
            <version>1.0-SNAPSHOT</version>
        </dependency>

        <!-- MapStruct -->
        <dependency>
            <groupId>org.mapstruct</groupId>
            <artifactId>mapstruct</artifactId>
        </dependency>

        <!-- Lombok (entities are @Data containers; provided is not transitive) -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <scope>provided</scope>
        </dependency>

        <!-- Testcontainers (repository integration tests — US-M1-008); 2.x relocated names, BOM-governed versions -->
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers-postgresql</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers-junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- Annotation processors: Lombok + MapStruct (+ binding so MapStruct
                 sees Lombok-generated accessors). Overrides the parent's lombok-only
                 annotationProcessorPaths, so all three must be listed here. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <annotationProcessorPaths>
                        <path>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                            <version>${lombok.version}</version>
                        </path>
                        <path>
                            <groupId>org.mapstruct</groupId>
                            <artifactId>mapstruct-processor</artifactId>
                            <version>${mapstruct.version}</version>
                        </path>
                        <path>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok-mapstruct-binding</artifactId>
                            <version>${lombok-mapstruct-binding.version}</version>
                        </path>
                    </annotationProcessorPaths>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>

</project>
