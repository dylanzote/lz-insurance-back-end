<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.lz_Insurance</groupId>
        <artifactId>lz_insurance</artifactId>
        <version>1.0-SNAPSHOT</version>
    </parent>

    <groupId>com.lz_Insurance.bom</groupId>
    <artifactId>insurance-bom</artifactId>

    <name>Insurance BOM</name>
    <description>Bill of Materials - Version Management for all Insurance Libraries</description>

    <properties>
        <maven.compiler.source>25</maven.compiler.source>
        <maven.compiler.target>25</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    </properties>

    <packaging>pom</packaging>

    <dependencyManagement>
        <dependencies>
            <!-- Internal Library Versions -->
            <dependency>
                <groupId>com.lz_Insurance.core</groupId>
                <artifactId>insurance-core</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.lz_Insurance.web</groupId>
                <artifactId>insurance-web</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.lz_Insurance.security.core</groupId>
                <artifactId>insurance-security-core</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.lz_Insurance.security.keycloak</groupId>
                <artifactId>insurance-security-keycloak</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.lz_Insurance.security.multitenancy</groupId>
                <artifactId>insurance-security-multitenancy</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.lz_Insurance.security.session</groupId>
                <artifactId>insurance-security-session</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.lz_Insurance.persistence</groupId>
                <artifactId>insurance-persistence</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.lz_Insurance.messaging</groupId>
                <artifactId>insurance-messaging</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.lz_Insurance.storage</groupId>
                <artifactId>insurance-storage</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.lz_Insurance.monitoring</groupId>
                <artifactId>insurance-monitoring</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.lz_Insurance.product.engine</groupId>
                <artifactId>insurance-product-engine</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.lz_Insurance.dto</groupId>
                <artifactId>insurance-dto</artifactId>
                <version>${project.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

</project>